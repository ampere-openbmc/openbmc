+++ b/include/pcieFunction.hpp
@@ -0,0 +1,75 @@
+#pragma once
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Association/Definitions/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/PCIeFunction/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using pcieFunctionInterface =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::PCIeFunction;
+using association =
+    sdbusplus::server::xyz::openbmc_project::association::Definitions;
+using item = sdbusplus::server::xyz::openbmc_project::inventory::Item;
+
+class PcieFunction :
+    sdbusplus::server::object_t<pcieFunctionInterface, item, association>
+{
+  public:
+    PcieFunction() = delete;
+    PcieFunction(const PcieFunction&) = delete;
+    PcieFunction& operator=(const PcieFunction&) = delete;
+    PcieFunction(PcieFunction&&) = delete;
+    PcieFunction& operator=(PcieFunction&&) = delete;
+    ~PcieFunction() = default;
+
+    struct PcieFunctionInfo
+    {
+        uint8_t type;
+        uint8_t length;
+        uint16_t handle;
+        uint16_t pcieDeviceHandle;
+        uint8_t functionNumber;
+        uint8_t revisionId;
+        uint16_t vendorId;
+        uint16_t deviceId;
+        uint16_t subSystemVendorId;
+        uint16_t subSystemDeviceId;
+        uint8_t baseClassCode;
+        uint8_t subClassCode;
+        uint8_t programmingInterface;
+    } __attribute__((packed));
+
+    PcieFunction(sdbusplus::bus_t& bus, const std::string& objPath,
+                 PcieFunctionInfo* functionInfo,
+                 const std::string& pcieDevice) :
+        sdbusplus::server::object_t<pcieFunctionInterface, item, association>(
+            bus, objPath.c_str()),
+        bus(bus), functionInfo(functionInfo), objectPath(objPath),
+        pcieDeviceObjPath(pcieDevice)
+    {
+        pcieFunctionInfoUpdate();
+    }
+
+    void pcieFunctionInfoUpdate();
+
+    std::string getObjectPath()
+    {
+        return objectPath;
+    }
+
+  private:
+    sdbusplus::bus_t& bus;
+    PcieFunctionInfo* functionInfo;
+    std::string objectPath;
+    std::string pcieDeviceObjPath;
+};
+
+} // namespace smbios
+
+} // namespace phosphor
diff --git a/include/pcieStorageFunction.hpp b/include/pcieStorageFunction.hpp
new file mode 100644
index 0000000..e433fa6
--- /dev/null
+++ b/include/pcieStorageFunction.hpp
@@ -0,0 +1,53 @@
+#pragma once
+#include "drive.hpp"
+#include "pcieFunction.hpp"
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using pcieFunction = phosphor::smbios::PcieFunction;
+using driveDevice = phosphor::smbios::DriveDevice;
+
+class PCIeStorageFunction
+{
+  public:
+    PCIeStorageFunction() = delete;
+    PCIeStorageFunction(const PCIeStorageFunction&) = delete;
+    PCIeStorageFunction& operator=(const PCIeStorageFunction&) = delete;
+    PCIeStorageFunction(PCIeStorageFunction&&) = delete;
+    PCIeStorageFunction& operator=(PCIeStorageFunction&&) = delete;
+    ~PCIeStorageFunction() = default;
+
+    struct PcieStorageFunc
+    {
+        pcieFunction::PcieFunctionInfo funcInfo;
+        driveDevice::DriveDeviceInfo driveInfo;
+    } __attribute__((packed));
+
+    PCIeStorageFunction(sdbusplus::bus_t& bus, const uint8_t& funcIndex,
+                        uint8_t* smbiosTableStorage,
+                        const std::string& pcieDevice) :
+        bus(bus), funcIndex(funcIndex), pcieDeviceObjPath(pcieDevice)
+    {
+        updateDeviceFunc(smbiosTableStorage, pcieDeviceObjPath);
+    }
+
+    void updateDeviceFunc(uint8_t* smbiosTableStorage,
+                               const std::string& pcieDevice);
+
+  private:
+    sdbusplus::bus_t& bus;
+    uint8_t funcIndex;
+    uint16_t handle;
+    std::string pcieDeviceObjPath;
+    std::unique_ptr<pcieFunction> pcieFunc = nullptr;
+    std::unique_ptr<driveDevice> driveDev = nullptr;
+};
+
+} // namespace smbios
+
+} // namespace phosphor
