diff --git a/src/pcieFunction.cpp b/src/pcieFunction.cpp
new file mode 100644
index 0000000..7960858
--- /dev/null
+++ b/src/pcieFunction.cpp
@@ -0,0 +1,34 @@
+#include "pcieFunction.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void PcieFunction::pcieFunctionInfoUpdate()
+{
+    if (!functionInfo)
+    {
+        return;
+    }
+
+    revisionId(functionInfo->revisionId);
+    vendorId(functionInfo->vendorId);
+    deviceId(functionInfo->deviceId);
+    subsystemVendorId(functionInfo->subSystemVendorId);
+    subsystemId(functionInfo->subSystemDeviceId);
+    baseClassCode(functionInfo->baseClassCode);
+    subClassCode(functionInfo->subClassCode);
+    programmingInterface(functionInfo->programmingInterface);
+
+    if (!pcieDeviceObjPath.empty())
+    {
+        association::associations(
+            {{"exposed_by", "exposing", pcieDeviceObjPath}});
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
diff --git a/src/pcieStorageFunction.cpp b/src/pcieStorageFunction.cpp
new file mode 100644
index 0000000..0481a6f
--- /dev/null
+++ b/src/pcieStorageFunction.cpp
@@ -0,0 +1,43 @@
+#include "pcieStorageFunction.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+void PCIeStorageFunction::updateDeviceFunc(uint8_t* smbiosTableStorage,
+                                                const std::string& pcieDevice)
+{
+    pcieDeviceObjPath = pcieDevice;
+    uint8_t* dataIn =
+        getTableData(smbiosTableStorage, pcieStorageFunction, funcIndex);
+
+    if (!dataIn)
+    {
+        return;
+    }
+
+    auto pcieDeviceInfo = reinterpret_cast<struct PcieStorageFunc*>(dataIn);
+    auto pcieFuncInfo =
+        reinterpret_cast<struct pcieFunction::PcieFunctionInfo*>(
+            &(pcieDeviceInfo->funcInfo));
+    auto driveInfo = reinterpret_cast<struct driveDevice::DriveDeviceInfo*>(
+        &(pcieDeviceInfo->driveInfo));
+
+    std::string funcPath =
+        pcieDeviceObjPath + "/Function" +
+        std::to_string(pcieDeviceInfo->funcInfo.functionNumber);
+    std::string drivePath = funcPath + "/Drive" + std::to_string(funcIndex);
+
+    pcieFunc = std::make_unique<pcieFunction>(bus, funcPath, pcieFuncInfo,
+                                              pcieDeviceObjPath);
+    driveDev = std::make_unique<driveDevice>(bus, drivePath, driveInfo,
+                                             funcPath, pcieDeviceObjPath);
+}
+
+} // namespace smbios
+
+} // namespace phosphor
