diff --git a/src/drive.cpp b/src/drive.cpp
new file mode 100644
index 0000000..48e33ec
--- /dev/null
+++ b/src/drive.cpp
@@ -0,0 +1,53 @@
+#include <cmath>
+#include "drive.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void DriveDevice::driveUpdate()
+{
+    if (!driveInfo)
+    {
+        return;
+    }
+
+    mediaType(driveInfo->mediaType);
+    capacity(driveInfo->storageCapacity * std::pow(1024, 3)); // in Bytes
+    functional(true);
+
+    std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+    if (!funcObjectPath.empty())
+    {
+        assocs.emplace_back("produced_by", "producing", funcObjectPath);
+    }
+
+    if (!pcieDeviceObjectPath.empty())
+    {
+        assocs.emplace_back("contained_by", "containing",
+                            pcieDeviceObjectPath);
+    }
+
+    if (!assocs.empty())
+    {
+        association::associations(assocs);
+    }
+}
+
+void DriveDevice::mediaType(const uint8_t type)
+{
+    driveInterface::type(driveType::Unknown);
+
+    std::map<uint8_t, driveType>::const_iterator it =
+        driveMediaTypeTable.find(type);
+    if (it != driveMediaTypeTable.end())
+    {
+        driveInterface::type(it->second);
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index 14bcf81..2de6cd6 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -16,6 +16,7 @@
 
 #include "mdrv2.hpp"
 
+#include "pcieStorageFunction.hpp"
 #include "pciedevice.hpp"
 #include "pcieslot.hpp"
 
@@ -715,6 +716,54 @@ void MDRV2::systemInfoUpdate()
             pcieSlotObjPath, motherboardPath));
     }
 
+    num = getTotalSmbiosEntries(pcieStorageFunction);
+    if (!num)
+    {
+        lg2::error("Get total pcie storage function failed.");
+        return;
+    }
+
+    pcieStorageFuncs.clear();
+    for (unsigned int index = 0; index < *num; index++)
+    {
+        std::string pcieDevicePath;
+        uint8_t* pcieDevicePtr =
+            getTableData(smbiosDir.dir[smbiosDirIndex].dataStorage,
+                         pcieStorageFunction, index);
+
+        if (pcieDevicePtr)
+        {
+            // The format of PCIe Storage function SMBIOS table is:
+            //  - Type: 1 byte
+            //  - length: 1 byte
+            //  - handle: 2 bytes
+            //  - Associate Hanlde: 2 bytes
+            //  ...
+            uint16_t associateHandle =
+                *(reinterpret_cast<uint16_t*>(pcieDevicePtr + 4));
+
+            for (auto it = pcieDevices.begin(); it != pcieDevices.end(); it++)
+            {
+                if ((*it)->getHandle() == associateHandle)
+                {
+                    pcieDevicePath = (*it)->getObjectPath();
+                    (*it)->addStorageInterface();
+                    break;
+                }
+            }
+        }
+
+        if (pcieDevicePath.empty())
+        {
+            continue;
+        }
+
+        pcieStorageFuncs.emplace_back(
+            std::make_unique<phosphor::smbios::PCIeStorageFunction>(
+                *bus, index, smbiosDir.dir[smbiosDirIndex].dataStorage,
+                pcieDevicePath));
+    }
+
 #endif
 
     system.reset();
