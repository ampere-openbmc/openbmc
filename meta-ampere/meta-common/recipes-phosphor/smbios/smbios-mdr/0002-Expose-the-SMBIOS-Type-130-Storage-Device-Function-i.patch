diff --git a/include/drive.hpp b/include/drive.hpp
new file mode 100644
index 0000000..c349cb3
--- /dev/null
+++ b/include/drive.hpp
@@ -0,0 +1,69 @@
+#pragma once
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Association/Definitions/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/Drive/server.hpp>
+#include <xyz/openbmc_project/State/Decorator/OperationalStatus/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using driveInterface =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::Drive;
+using operationalStatus = sdbusplus::xyz::openbmc_project::State::Decorator::
+    server::OperationalStatus;
+using association =
+    sdbusplus::server::xyz::openbmc_project::association::Definitions;
+using driveType =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::Drive::DriveType;
+
+class DriveDevice :
+    sdbusplus::server::object_t<driveInterface, operationalStatus, association>
+{
+  public:
+    DriveDevice() = delete;
+    DriveDevice(const DriveDevice&) = delete;
+    DriveDevice& operator=(const DriveDevice&) = delete;
+    DriveDevice(DriveDevice&&) = delete;
+    DriveDevice& operator=(DriveDevice&&) = delete;
+    ~DriveDevice() = default;
+
+    struct DriveDeviceInfo
+    {
+        uint8_t mediaType;
+        uint64_t storageCapacity;
+    } __attribute__((packed));
+
+    DriveDevice(sdbusplus::bus_t& bus, const std::string& objPath,
+                DriveDeviceInfo* deviceInfo, const std::string& funcObjPath,
+                const std::string& pcieDeviceObjPath) :
+        sdbusplus::server::object_t<driveInterface, operationalStatus,
+                                    association>(bus, objPath.c_str()),
+        objectPath(objPath), funcObjectPath(funcObjPath),
+        pcieDeviceObjectPath(pcieDeviceObjPath), driveInfo(deviceInfo)
+    {
+        driveUpdate();
+    }
+
+    void driveUpdate();
+    void mediaType(const uint8_t type);
+
+  private:
+    std::string objectPath;
+    std::string funcObjectPath;
+    std::string pcieDeviceObjectPath;
+    DriveDeviceInfo* driveInfo;
+};
+
+const std::map<uint8_t, driveType> driveMediaTypeTable = {
+    {0x00, driveType::Unknown},
+    {0x01, driveType::HDD},
+    {0x02, driveType::SMR},
+    {0x03, driveType::SSD}};
+
+} // namespace smbios
+
+} // namespace phosphor
