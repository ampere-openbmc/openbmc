@@ -0,0 +1,63 @@
+#pragma once
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Association/Definitions/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/NetworkInterface/server.hpp>
+#include <xyz/openbmc_project/State/Decorator/OperationalStatus/server.hpp>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using networkInterface =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::NetworkInterface;
+using operationalStatus = sdbusplus::xyz::openbmc_project::State::Decorator::
+    server::OperationalStatus;
+using association =
+    sdbusplus::server::xyz::openbmc_project::association::Definitions;
+
+class NetworkDevice :
+    sdbusplus::server::object_t<networkInterface, operationalStatus,
+                                association>
+{
+  public:
+    NetworkDevice() = delete;
+    NetworkDevice(const NetworkDevice&) = delete;
+    NetworkDevice& operator=(const NetworkDevice&) = delete;
+    NetworkDevice(NetworkDevice&&) = delete;
+    NetworkDevice& operator=(NetworkDevice&&) = delete;
+    ~NetworkDevice() = default;
+
+    struct NetworkDeviceInfo
+    {
+        uint8_t macAddress;
+    } __attribute__((packed));
+
+    NetworkDevice(sdbusplus::bus_t& bus, const std::string& objPath,
+                  NetworkDeviceInfo* deviceInfo, const std::string& funcObjPath,
+                  const std::string& pcieDeviceObjPath,
+                  const std::string& macAddress) :
+        sdbusplus::server::object_t<networkInterface, operationalStatus,
+                                    association>(bus, objPath.c_str()),
+        objectPath(objPath), funcObjectPath(funcObjPath),
+        pcieDeviceObjectPath(pcieDeviceObjPath), networkInfo(deviceInfo)
+    {
+        networkUpdate(macAddress);
+    }
+
+    void networkUpdate(const std::string& macAddress);
+    void macAddress(const uint8_t positionNum, const uint8_t structLen,
+                    uint8_t* dataIn);
+
+  private:
+    std::string objectPath;
+    std::string funcObjectPath;
+    std::string pcieDeviceObjectPath;
+    NetworkDeviceInfo* networkInfo;
+};
+
+} // namespace smbios
+
+} // namespace phosphor
diff --git a/include/pcieNetworkFunction.hpp b/include/pcieNetworkFunction.hpp
new file mode 100644
index 0000000..d1c076f
--- /dev/null
+++ b/include/pcieNetworkFunction.hpp
@@ -0,0 +1,55 @@
+#pragma once
+#include "network.hpp"
+#include "pcieFunction.hpp"
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using pcieFunction = phosphor::smbios::PcieFunction;
+using networkDevice = phosphor::smbios::NetworkDevice;
+
+class PCIeNetworkFunction
+{
+  public:
+    PCIeNetworkFunction() = delete;
+    PCIeNetworkFunction(const PCIeNetworkFunction&) = delete;
+    PCIeNetworkFunction& operator=(const PCIeNetworkFunction&) = delete;
+    PCIeNetworkFunction(PCIeNetworkFunction&&) = delete;
+    PCIeNetworkFunction& operator=(PCIeNetworkFunction&&) = delete;
+    ~PCIeNetworkFunction() = default;
+
+    struct PcieNetworkFunc
+    {
+        pcieFunction::PcieFunctionInfo funcInfo;
+        networkDevice::NetworkDeviceInfo networkInfo;
+    } __attribute__((packed));
+
+    PCIeNetworkFunction(sdbusplus::bus_t& bus, const uint8_t& funcIndex,
+                        uint8_t* smbiosTableStorage,
+                        const std::string& pcieDevice) :
+        bus(bus), funcIndex(funcIndex), pcieDeviceObjPath(pcieDevice)
+    {
+        updateDeviceFunc(smbiosTableStorage, pcieDeviceObjPath);
+    }
+
+    void updateDeviceFunc(uint8_t* smbiosTableStorage,
+                               const std::string& pcieDevice);
+    std::string getMacAddress(const uint8_t positionNum,
+                              const uint8_t structLen, uint8_t* dataIn);
+
+  private:
+    sdbusplus::bus_t& bus;
+    uint8_t funcIndex;
+    uint16_t handle;
+    std::string pcieDeviceObjPath;
+    std::unique_ptr<pcieFunction> pcieFunc = nullptr;
+    std::unique_ptr<networkDevice> networkDev = nullptr;
+};
+
+} // namespace smbios
+
+} // namespace phosphor
