diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index 2de6cd6..a7a847f 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -764,6 +764,54 @@ void MDRV2::systemInfoUpdate()
                 pcieDevicePath));
     }
 
+    num = getTotalSmbiosEntries(pcieNetworkFunction);
+    if (!num)
+    {
+        lg2::error("Get total pcie network function failed.");
+        return;
+    }
+
+    pcieNetworkFuncs.clear();
+    for (unsigned int index = 0; index < *num; index++)
+    {
+        std::string pcieDevicePath;
+        uint8_t* pcieDevicePtr =
+            getTableData(smbiosDir.dir[smbiosDirIndex].dataStorage,
+                         pcieNetworkFunction, index);
+
+        if (pcieDevicePtr)
+        {
+            // The format of PCIe Network function SMBIOS table is:
+            //  - Type: 1 byte
+            //  - length: 1 byte
+            //  - handle: 2 bytes
+            //  - Associate Hanlde: 2 bytes
+            //  ...
+            uint16_t associateHandle =
+                *(reinterpret_cast<uint16_t*>(pcieDevicePtr + 4));
+
+            for (auto it = pcieDevices.begin(); it != pcieDevices.end(); it++)
+            {
+                if ((*it)->getHandle() == associateHandle)
+                {
+                    pcieDevicePath = (*it)->getObjectPath();
+                    (*it)->addEthernetInterface();
+                    break;
+                }
+            }
+        }
+
+        if (pcieDevicePath.empty())
+        {
+            continue;
+        }
+
+        pcieNetworkFuncs.emplace_back(
+            std::make_unique<phosphor::smbios::PCIeNetworkFunction>(
+                *bus, index, smbiosDir.dir[smbiosDirIndex].dataStorage,
+                pcieDevicePath));
+    }
+
 #endif
 
     system.reset();
