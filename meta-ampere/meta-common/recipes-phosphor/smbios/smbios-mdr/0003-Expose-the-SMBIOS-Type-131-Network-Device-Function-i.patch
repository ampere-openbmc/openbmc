diff --git a/src/network.cpp b/src/network.cpp
new file mode 100644
index 0000000..c48ec1f
--- /dev/null
+++ b/src/network.cpp
@@ -0,0 +1,38 @@
+#include "network.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void NetworkDevice::networkUpdate(const std::string& macAddress)
+{
+    if (!networkInfo)
+    {
+        return;
+    }
+
+    networkInterface::macAddress(macAddress);
+
+    std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+    if (!funcObjectPath.empty())
+    {
+        assocs.emplace_back("produced_by", "producing", funcObjectPath);
+    }
+
+    if (!pcieDeviceObjectPath.empty())
+    {
+        assocs.emplace_back("contained_by", "containing",
+                            pcieDeviceObjectPath);
+    }
+
+    if (!assocs.empty())
+    {
+        association::associations(assocs);
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
diff --git a/src/pcieNetworkFunction.cpp b/src/pcieNetworkFunction.cpp
new file mode 100644
index 0000000..b5eb27f
--- /dev/null
+++ b/src/pcieNetworkFunction.cpp
@@ -0,0 +1,54 @@
+#include "pcieNetworkFunction.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+void PCIeNetworkFunction::updateDeviceFunc(uint8_t* smbiosTableStorage,
+                                                const std::string& pcieDevice)
+{
+    pcieDeviceObjPath = pcieDevice;
+    uint8_t* dataIn =
+        getTableData(smbiosTableStorage, pcieNetworkFunction, funcIndex);
+
+    if (!dataIn)
+    {
+        return;
+    }
+
+    auto pcieDeviceInfo = reinterpret_cast<struct PcieNetworkFunc*>(dataIn);
+    auto pcieFuncInfo =
+        reinterpret_cast<struct pcieFunction::PcieFunctionInfo*>(
+            &(pcieDeviceInfo->funcInfo));
+    auto networkInfo =
+        reinterpret_cast<struct networkDevice::NetworkDeviceInfo*>(
+            &(pcieDeviceInfo->networkInfo));
+
+    // Get Mac address
+    std::string macAddress =
+        getMacAddress(networkInfo->macAddress, pcieFuncInfo->length, dataIn);
+    std::string funcPath =
+        pcieDeviceObjPath + "/Function" +
+        std::to_string(pcieDeviceInfo->funcInfo.functionNumber);
+    std::string drivePath =
+        funcPath + "/NetworkInterface" + std::to_string(funcIndex);
+
+    pcieFunc = std::make_unique<pcieFunction>(bus, funcPath, pcieFuncInfo,
+                                              pcieDeviceObjPath);
+    networkDev = std::make_unique<networkDevice>(
+        bus, drivePath, networkInfo, funcPath, pcieDeviceObjPath, macAddress);
+}
+
+std::string PCIeNetworkFunction::getMacAddress(
+    const uint8_t positionNum, const uint8_t structLen, uint8_t* dataIn)
+{
+    return positionToString(positionNum, structLen, dataIn);
+}
+
+} // namespace smbios
+
+} // namespace phosphor
