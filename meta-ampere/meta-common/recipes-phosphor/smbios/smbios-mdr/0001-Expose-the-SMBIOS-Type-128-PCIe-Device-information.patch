diff --git a/src/pciedevice.cpp b/src/pciedevice.cpp
new file mode 100644
index 0000000..d0465ba
--- /dev/null
+++ b/src/pciedevice.cpp
@@ -0,0 +1,124 @@
+#include "pciedevice.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+#include <boost/algorithm/string.hpp>
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void PcieDevice::pcieDeviceInfoUpdate(uint8_t* smbiosTableStorage,
+                                      const std::string& pcieSlot)
+{
+    pcieSlotObjPath = pcieSlot;
+    uint8_t* dataIn =
+        getTableData(smbiosTableStorage, pcieDeviceType, pcieDeviceIndex);
+
+    if (!dataIn)
+    {
+        return;
+    }
+
+    auto pcieDeviceInfo = reinterpret_cast<struct PCIeDeviceInfo*>(dataIn);
+
+    // Update properties of Dbus interface asset
+    serialNumber(pcieDeviceInfo->serialNumber, pcieDeviceInfo->length, dataIn);
+    partNumber(pcieDeviceInfo->partNumber, pcieDeviceInfo->length, dataIn);
+    model(pcieDeviceInfo->modelName, pcieDeviceInfo->length, dataIn);
+    firmwareVersion(pcieDeviceInfo->firmwareVersion, pcieDeviceInfo->length,
+                    dataIn);
+    present(true);
+    type(pcieDeviceInfo->deviceType);
+    lanesInUse(pcieDeviceInfo->currentLinkWidth);
+    maxLanes(pcieDeviceInfo->maxLinkWidth);
+    currentLinkSpeed(pcieDeviceInfo->currentLinkSpeed);
+    maxLinkSpeed(pcieDeviceInfo->maxLinkSpeed);
+
+    if (!pcieSlotObjPath.empty())
+    {
+        association::associations(
+            {{"contained_by", "associated_pcie_device", pcieSlotObjPath}});
+    }
+
+    handle = pcieDeviceInfo->handle;
+}
+
+void PcieDevice::partNumber(const uint8_t positionNum, const uint8_t structLen,
+                            uint8_t* dataIn)
+{
+    std::string result = positionToString(positionNum, structLen, dataIn);
+    // Part number could contain spaces. Eg: "  abcd123  ". Since its
+    // unnecessary, we should remove them.
+    boost::algorithm::trim_left(result);
+    boost::algorithm::trim_right(result);
+    asset::partNumber(result);
+}
+
+void PcieDevice::serialNumber(const uint8_t positionNum,
+                              const uint8_t structLen, uint8_t* dataIn)
+{
+    std::string result = positionToString(positionNum, structLen, dataIn);
+    // Serial number could contain spaces. Eg: "  abcd123  ". Since its
+    // unnecessary, we should remove them.
+    boost::algorithm::trim_left(result);
+    boost::algorithm::trim_right(result);
+    asset::serialNumber(result);
+}
+
+void PcieDevice::model(const uint8_t positionNum, const uint8_t structLen,
+                       uint8_t* dataIn)
+{
+    std::string result = positionToString(positionNum, structLen, dataIn);
+    // Model could contain spaces. Eg: "  abcd123  ". Since its
+    // unnecessary, we should remove them.
+    boost::algorithm::trim_left(result);
+    boost::algorithm::trim_right(result);
+    asset::model(result);
+}
+
+void PcieDevice::firmwareVersion(const uint8_t positionNum,
+                                 const uint8_t structLen, uint8_t* dataIn)
+{
+    softwareVersion::version(positionToString(positionNum, structLen, dataIn));
+}
+
+void PcieDevice::currentLinkSpeed(const uint8_t type)
+{
+    pcieDevice::generationInUse(pcieGeneration::Unknown);
+
+    std::map<uint8_t, pcieGeneration>::const_iterator it =
+        pcieGensTable.find(type);
+    if (it != pcieGensTable.end())
+    {
+        pcieDevice::generationInUse(it->second);
+    }
+}
+
+void PcieDevice::maxLinkSpeed(const uint8_t type)
+{
+    pcieDevice::generationSupported(pcieGeneration::Unknown);
+
+    std::map<uint8_t, pcieGeneration>::const_iterator it =
+        pcieGensTable.find(type);
+    if (it != pcieGensTable.end())
+    {
+        pcieDevice::generationSupported(it->second);
+    }
+}
+
+void PcieDevice::type(const uint8_t type)
+{
+    pcieDevice::deviceType(mediaType::Unknown);
+
+    std::map<uint8_t, mediaType>::const_iterator it =
+        pcieDeviceTypeTable.find(type);
+    if (it != pcieDeviceTypeTable.end())
+    {
+        pcieDevice::deviceType(it->second);
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
