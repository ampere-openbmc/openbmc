diff --git a/src/mdrv2.cpp b/src/mdrv2.cpp
index 070541c..65dd1b2 100644
--- a/src/mdrv2.cpp
+++ b/src/mdrv2.cpp
@@ -16,6 +16,7 @@
 
 #include "mdrv2.hpp"
 
+#include "pciedevice.hpp"
 #include "pcieslot.hpp"
 
 #include <sys/mman.h>
@@ -668,6 +669,52 @@ void MDRV2::systemInfoUpdate()
                 *bus, path, index, smbiosDir.dir[smbiosDirIndex].dataStorage));
     }
 
+#endif
+
+#ifdef PCIE_INVENTOTY_DBUS
+
+    num = getTotalSmbiosEntries(pcieDeviceType);
+    if (!num)
+    {
+        lg2::error("Get total pcie device failed.");
+        return;
+    }
+
+    pcieDevices.clear();
+    for (unsigned int index = 0; index < *num; index++)
+    {
+        std::string path =
+            smbiosInventoryPath + pcieDeviceSuffix + std::to_string(index);
+        std::string pcieSlotObjPath;
+        uint8_t* pcieDevicePtr = getTableData(
+            smbiosDir.dir[smbiosDirIndex].dataStorage, pcieDeviceType, index);
+
+        if (pcieDevicePtr)
+        {
+            // The format of PCIe device SMBIOS table is:
+            //  - Type: 1 byte
+            //  - length: 1 byte
+            //  - handle: 2 bytes
+            //  - Associate Hanlde: 2 bytes
+            //  ...
+            uint16_t associateHandle =
+                *(reinterpret_cast<uint16_t*>(pcieDevicePtr + 4));
+
+            for (auto it = pcies.begin(); it != pcies.end(); it++)
+            {
+                if ((*it)->getHandle() == associateHandle)
+                {
+                    pcieSlotObjPath = (*it)->getObjectPath();
+                    break;
+                }
+            }
+        }
+
+        pcieDevices.emplace_back(std::make_unique<phosphor::smbios::PcieDevice>(
+            *bus, path, index, smbiosDir.dir[smbiosDirIndex].dataStorage,
+            pcieSlotObjPath));
+    }
+
 #endif
 
     system.reset();
