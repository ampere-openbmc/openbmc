@@ -174,6 +174,9 @@ static constexpr const char* systemSuffix = "/chassis/motherboard/bios";
 
 static constexpr const char* tpmSuffix = "/chassis/motherboard/tpm";
 
+static constexpr const char* pcieDeviceSuffix =
+    "/chassis/motherboard/pciedevice";
+
 static constexpr const char* firmwarePath = "/xyz/openbmc_project/software";
 
 constexpr std::array<SMBIOSVersion, 8> supportedSMBIOSVersions{
@@ -205,6 +208,7 @@ typedef enum
     onboardDevicesExtended = 41,
     tpmDeviceType = 43,
     firmwareInventoryInformationType = 45,
+    pcieDeviceType = 128,
 } SmbiosType;
 
 static constexpr uint8_t separateLen = 2;
@@ -364,3 +368,32 @@ static inline std::string getObjectPath(
 #endif
     return path;
 }
+
+static inline uint8_t* getTableData(uint8_t* smbiosDataIn, uint8_t typeId,
+                                    uint8_t devIndex)
+{
+    uint8_t* dataIn = smbiosDataIn;
+
+    dataIn = getSMBIOSTypePtr(dataIn, typeId);
+
+    if (!dataIn)
+    {
+        return nullptr;
+    }
+
+    for (uint8_t index = 0; index < devIndex; index++)
+    {
+        dataIn = smbiosNextPtr(dataIn);
+        if (!dataIn)
+        {
+            return nullptr;
+        }
+        dataIn = getSMBIOSTypePtr(dataIn, typeId);
+        if (!dataIn)
+        {
+            return nullptr;
+        }
+    }
+
+    return dataIn;
+}
