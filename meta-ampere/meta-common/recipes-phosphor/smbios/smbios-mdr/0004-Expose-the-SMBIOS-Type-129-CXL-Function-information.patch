+namespace smbios
+{
+
+using cxlInterface =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::CXLLogicalDevice;
+using operationalStatus = sdbusplus::xyz::openbmc_project::State::Decorator::
+    server::OperationalStatus;
+using association =
+    sdbusplus::server::xyz::openbmc_project::association::Definitions;
+
+class CxlLogicalDevice :
+    sdbusplus::server::object_t<cxlInterface, operationalStatus, association>
+{
+  public:
+    CxlLogicalDevice() = delete;
+    CxlLogicalDevice(const CxlLogicalDevice&) = delete;
+    CxlLogicalDevice& operator=(const CxlLogicalDevice&) = delete;
