+    if (!funcObjectPath.empty())
+    {
+        assocs.emplace_back("handled_by", "referenced_by", funcObjectPath);
+    }
+
+    if (!pcieDeviceObjectPath.empty())
+    {
+        assocs.emplace_back("partitioned_by", "organized_by",
+                            pcieDeviceObjectPath);
+    }
+
+    if (!memoryDomainObjectPath.empty())
+    {
+        assocs.emplace_back("collected_into", "assembled_into",
+                            memoryDomainObjectPath);
+    }
+
+    if (!assocs.empty())
+    {
+        association::associations(assocs);
+    }
+}
+
+void MemoryChunks::location(const uint8_t type)
+{
+    // Set Location to Local as default
+    memoryChunksInterface::mediaLocation(chunksLocation::Local);
+
+    std::map<uint8_t, chunksLocation>::const_iterator it =
+        memoryLocationTable.find(type);
+    if (it != memoryLocationTable.end())
+    {
+        memoryChunksInterface::mediaLocation(it->second);
+    }
+}
