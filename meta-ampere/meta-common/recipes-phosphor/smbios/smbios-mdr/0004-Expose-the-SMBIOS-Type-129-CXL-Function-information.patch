+    num = getTotalSmbiosEntries(pcieCxlFunction);
+    if (!num)
+    {
+        lg2::error("Get total pcie CXL function failed.");
+        return;
+    }
+
+    pcieCxlFuncs.clear();
+    for (unsigned int index = 0; index < *num; index++)
+    {
+        std::string pcieDevicePath;
+        uint8_t* pcieDevicePtr = getTableData(
+            smbiosDir.dir[smbiosDirIndex].dataStorage, pcieCxlFunction, index);
+
+        if (pcieDevicePtr)
+        {
+            // The format of PCIe CXL function SMBIOS table is:
+            //  - Type: 1 byte
+            //  - length: 1 byte
+            //  - handle: 2 bytes
+            //  - Associate Hanlde: 2 bytes
+            //  ...
+            uint16_t associateHandle =
+                *(reinterpret_cast<uint16_t*>(pcieDevicePtr + 4));
+
+            for (auto it = pcieDevices.begin(); it != pcieDevices.end(); it++)
+            {
+                if ((*it)->getHandle() == associateHandle)
+                {
+                    pcieDevicePath = (*it)->getObjectPath();
+                    (*it)->addCxlInterface();
+                    break;
+                }
+            }
+        }
+
+        if (pcieDevicePath.empty())
+        {
+            continue;
+        }
+
+        pcieCxlFuncs.emplace_back(
+            std::make_unique<phosphor::smbios::PCIeCxlFunction>(
+                *bus, index, smbiosDir.dir[smbiosDirIndex].dataStorage,
+                pcieDevicePath));
+    }
