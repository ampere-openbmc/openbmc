+++ b/src/pcieCxlFunction.cpp
@@ -0,0 +1,65 @@
+#include "pcieCxlFunction.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+void PCIeCxlFunction::updateDeviceFunc(uint8_t* smbiosTableStorage,
+                                        const std::string& pcieDevice)
+{
+    pcieDeviceObjPath = pcieDevice;
+    uint8_t* dataIn =
+        getTableData(smbiosTableStorage, pcieCxlFunction, funcIndex);
+
+    if (!dataIn)
+    {
+        return;
+    }
+
+    auto pcieDeviceInfo = reinterpret_cast<struct PcieCxlFunc*>(dataIn);
+    auto pcieFuncInfo =
+        reinterpret_cast<struct pcieFunction::PcieFunctionInfo*>(
+            &(pcieDeviceInfo->funcInfo));
+    auto cxlLogicalDeviceInfo =
+        reinterpret_cast<struct cxlLogicalDevice::CxlLogicalDeviceInfo*>(
+            &(pcieDeviceInfo->cxlLogicalDeviceInfo));
+    auto memoryDeviceInfo = reinterpret_cast<struct memoryDevice::MemoryInfo*>(
+        &(pcieDeviceInfo->memoryDeviceInfo));
+    auto memoryChunksDeviceInfo =
+        reinterpret_cast<struct memoryChunksDevice::MemoryChunksInfo*>(
+            &(pcieDeviceInfo->memoryChunksDeviceInfo));
+
+    std::string funcPath =
+        pcieDeviceObjPath + "/Function" +
+        std::to_string(pcieDeviceInfo->funcInfo.functionNumber);
+    std::string cxlLogicalDevicePath =
+        funcPath + "/CXLLogicalDevice" + std::to_string(funcIndex);
+    std::string memorylDevicePath =
+        funcPath + "/Memory" + std::to_string(funcIndex);
+    std::string memoryChunkslDevicePath =
+        funcPath + "/MemoryChunk" + std::to_string(funcIndex);
+    std::string memoryDomainDevicePath =
+        funcPath + "/MemoryDomain" + std::to_string(funcIndex);
+
+    pcieFunc = std::make_unique<pcieFunction>(bus, funcPath, pcieFuncInfo,
+                                              pcieDeviceObjPath);
+    cxlLogicalDev = std::make_unique<cxlLogicalDevice>(
+        bus, cxlLogicalDevicePath, cxlLogicalDeviceInfo, funcPath,
+        pcieDeviceObjPath, memoryChunkslDevicePath, memoryDomainDevicePath);
+    memoryDev = std::make_unique<memoryDevice>(
+        bus, memorylDevicePath, memoryDeviceInfo, funcPath, pcieDeviceObjPath,
+        memoryChunkslDevicePath, memoryDomainDevicePath);
+    memoryChunksDev = std::make_unique<memoryChunksDevice>(
+        bus, memoryChunkslDevicePath, memoryChunksDeviceInfo, funcPath,
+        pcieDeviceObjPath, memoryDomainDevicePath);
+    memoryDomainDev = std::make_unique<memoryDomainDevice>(
+        bus, memoryDomainDevicePath, funcPath, pcieDeviceObjPath);
+}
+
+} // namespace smbios
