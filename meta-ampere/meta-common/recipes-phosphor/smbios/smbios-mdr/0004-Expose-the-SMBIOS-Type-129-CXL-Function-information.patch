diff --git a/src/cxlLogicalDevice.cpp b/src/cxlLogicalDevice.cpp
new file mode 100644
index 0000000..08f613e
--- /dev/null
+++ b/src/cxlLogicalDevice.cpp
@@ -0,0 +1,51 @@
+#include "cxlLogicalDevice.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void CxlLogicalDevice::cxlUpdate()
+{
+    if (!cxlInfo)
+    {
+        return;
+    }
+
+    memoryCapacity(cxlInfo->memoryCapacity);
+    functional(true);
+
+    std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+    if (!funcObjectPath.empty())
+    {
+        assocs.emplace_back("operated_by", "mapped_to", funcObjectPath);
+    }
+
+    if (!pcieDeviceObjectPath.empty())
+    {
+        assocs.emplace_back("hosted_by", "provisioned_by",
+                            pcieDeviceObjectPath);
+    }
+
+    if (!memoryChunksObjectPath.empty())
+    {
+        assocs.emplace_back("segmented_by", "operated_for",
+                            memoryChunksObjectPath);
+    }
+
+    if (!memoryDomainObjectPath.empty())
+    {
+        assocs.emplace_back("bound_with", "structured_for",
+                            memoryDomainObjectPath);
+    }
+
+    if (!assocs.empty())
+    {
+        association::associations(assocs);
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
