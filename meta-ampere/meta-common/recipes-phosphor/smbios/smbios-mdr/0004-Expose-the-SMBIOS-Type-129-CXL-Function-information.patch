diff --git a/src/memory.cpp b/src/memory.cpp
new file mode 100644
index 0000000..fa386ea
--- /dev/null
+++ b/src/memory.cpp
@@ -0,0 +1,69 @@
+#include "memory.hpp"
+
+#include "smbios_mdrv2.hpp"
+
+namespace phosphor
+{
+namespace smbios
+{
+
+void Memory::memoryUpdate()
+{
+    if (!memoryInfo)
+    {
+        return;
+    }
+
+    dimmMedia(memoryInfo->memoryType);
+    power(memoryInfo->powerConsumption);
+    functional(true);
+
+    std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+    if (!funcObjectPath.empty())
+    {
+        assocs.emplace_back("served_by", "addressed_by", funcObjectPath);
+    }
+
+    if (!pcieDeviceObjectPath.empty())
+    {
+        assocs.emplace_back("presented_by", "governed_by",
+                            pcieDeviceObjectPath);
+    }
+
+    if (!memoryChunksObjectPath.empty())
+    {
+        assocs.emplace_back("divided_into", "composed_of",
+                            memoryChunksObjectPath);
+    }
+
+    if (!memoryDomainObjectPath.empty())
+    {
+        assocs.emplace_back("grouped_into", "integrated_into",
+                            memoryDomainObjectPath);
+    }
+
+    if (!assocs.empty())
+    {
+        association::associations(assocs);
+    }
+}
+
+void Memory::dimmMedia(const uint8_t type)
+{
+    memoryInterface::memoryMedia(memoryTechType::Unknown);
+
+    std::map<uint8_t, memoryTechType>::const_iterator it =
+        memoryTechTypeTable.find(type);
+    if (it != memoryTechTypeTable.end())
+    {
+        memoryInterface::memoryMedia(it->second);
+    }
+}
+
+void Memory::power(const uint32_t value)
+{
+    powerManagementPolicy::maxTDPmW(value);
+}
+
+} // namespace smbios
+} // namespace phosphor
