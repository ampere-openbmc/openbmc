 users.hpp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/users.hpp b/users.hpp
index 39c3ec3..1fd9765 100644
--- a/users.hpp
+++ b/users.hpp
@@ -18,6 +18,7 @@
 
