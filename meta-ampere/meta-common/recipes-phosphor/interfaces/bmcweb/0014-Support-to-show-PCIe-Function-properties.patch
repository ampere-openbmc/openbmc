+inline void getPCIeFunctionPropertiesFromFunctionDbus(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& pcieFunctionPath, const std::string& service)
+{
+    dbus::utility::getAllProperties(
+        service, pcieFunctionPath,
+        "xyz.openbmc_project.Inventory.Item.PCIeFunction",
+        [asyncResp{asyncResp}](
+            const boost::system::error_code& ec,
+            const dbus::utility::DBusPropertiesMap& functionList) {
+            if (ec)
+            {
+                if (ec.value() != EBADR)
+                {
+                    BMCWEB_LOG_ERROR("DBUS response error for Properties{}",
+                                     ec.value());
+                    messages::internalError(asyncResp->res);
+                }
+                return;
+            }
+
+            const uint16_t* vendorId = nullptr;
+            const uint16_t* deviceId = nullptr;
+            const uint8_t* baseClassCode = nullptr;
+            const uint8_t* subClassCode = nullptr;
+            const uint8_t* programmingInterface = nullptr;
+            const uint16_t* subsystemVendorId = nullptr;
+            const uint16_t* subsystemId = nullptr;
+            const uint8_t* functionNumber = nullptr;
+            const uint8_t* revisionId = nullptr;
+
+            const bool success = sdbusplus::unpackPropertiesNoThrow(
+                dbus_utils::UnpackErrorPrinter(), functionList, "VendorId",
+                vendorId, "DeviceId", deviceId, "BaseClassCode", baseClassCode,
+                "SubClassCode", subClassCode, "ProgrammingInterface",
+                programmingInterface, "SubsystemVendorId", subsystemVendorId,
+                "SubsystemId", subsystemId, "FunctionNumber", functionNumber,
+                "RevisionId", revisionId);
+
+            if (!success)
+            {
+                messages::internalError(asyncResp->res);
+                return;
+            }
+
+            if (vendorId)
+            {
+                asyncResp->res.jsonValue["VendorId"] =
+                    "0x" + intToHexString(*vendorId, 4);
+            }
+            if (deviceId)
+            {
+                asyncResp->res.jsonValue["DeviceId"] =
+                    "0x" + intToHexString(*deviceId, 4);
+            }
+            // PCI Base Class Code is used to identify the generic function of
+            // the device. Refer to PCI Code and ID Assignment Specification,
+            // https://pcisig.com/sites/default/files/files/PCI_Code-ID_r_1_11__v24_Jan_2019.pdf
+            if (baseClassCode)
+            {
+                std::optional<pcie_function::DeviceClass> redfishDeviceClass =
+                    pcie_util::smbiosDevClassToRedfishDevClass(*baseClassCode);
+                if (!redfishDeviceClass)
+                {
+                    BMCWEB_LOG_WARNING("Unknown PCIe Base Class Code: {}",
+                                       *baseClassCode);
+                }
+                else
+                {
+                    if (*redfishDeviceClass ==
+                        pcie_function::DeviceClass::Invalid)
+                    {
+                        BMCWEB_LOG_ERROR("Invalid PCIe DeviceClass: {}",
+                                         *baseClassCode);
+                        messages::internalError(asyncResp->res);
+                        return;
+                    }
+                    asyncResp->res.jsonValue["DeviceClass"] =
+                        *redfishDeviceClass;
+                }
+            }
+            // Class Code in the PCI Configuration space has 3 bytes such as
+            // Class Code, SubClass Code, and PIFClass Code.
+            if (baseClassCode && subClassCode && programmingInterface)
+            {
+                asyncResp->res.jsonValue["ClassCode"] =
+                    "0x" + intToHexString(*baseClassCode, 2) +
+                    intToHexString(*subClassCode, 2) +
+                    intToHexString(*programmingInterface, 2);
+            }
+            if (subsystemVendorId)
+            {
+                asyncResp->res.jsonValue["SubsystemVendorId"] =
+                    "0x" + intToHexString(*subsystemVendorId, 4);
+            }
+            if (subsystemId)
+            {
+                asyncResp->res.jsonValue["SubsystemId"] =
+                    "0x" + intToHexString(*subsystemId, 4);
+            }
+            if (functionNumber)
+            {
+                asyncResp->res.jsonValue["FunctionId"] = *functionNumber;
+            }
+            if (revisionId)
+            {
+                asyncResp->res.jsonValue["RevisionId"] =
+                    "0x" + intToHexString(*revisionId, 2);
+            }
+        });
+}
+
+inline void getValidPcieFunctionPath(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& pcieDevicePath, uint64_t pcieFunctionId,
+    const std::function<void(const std::string& pcieFunctionPath)>& callback)
+{
+    const std::string& pcieFunctionIdStr =
+        "Function" + std::to_string(pcieFunctionId);
+    static constexpr std::array<std::string_view, 1> functionInterface = {
+        "xyz.openbmc_project.Inventory.Item.PCIeFunction"};
+    dbus::utility::getAssociatedSubTree(
+        pcieDevicePath + "/embedeing",
+        sdbusplus::message::object_path("/xyz/openbmc_project/inventory"), 0,
+        functionInterface,
+        [asyncResp, callback = std::move(callback), pcieFunctionIdStr](
+            const boost::system::error_code& ec,
+            const dbus::utility::MapperGetSubTreeResponse& subtree) {
+            if (ec)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error for Subtree{}",
+                                 ec.value());
+                messages::internalError(asyncResp->res);
+            }
+
+            if (subtree.empty())
+            {
+                BMCWEB_LOG_DEBUG("DBUS response error");
+                return;
+            }
+
+            for (const auto& [functionPath, serviceMaps] : subtree)
+            {
+                std::string functionName =
+                    sdbusplus::message::object_path(functionPath).filename();
+                if (pcieFunctionIdStr == functionName)
+                {
+                    callback(functionPath);
+                    return;
+                }
+            }
+
+            BMCWEB_LOG_ERROR("Invalid Function path {}", pcieFunctionIdStr);
+            messages::resourceNotFound(asyncResp->res, "PCIeFunction",
+                                       pcieFunctionIdStr);
+        });
+}
