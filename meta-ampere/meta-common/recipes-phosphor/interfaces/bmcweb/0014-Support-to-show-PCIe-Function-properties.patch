+const std::map<uint8_t, pcie_function::DeviceClass> deviceClassCodeMap = {
+    {0x00, pcie_function::DeviceClass::Invalid},
+    {0x01, pcie_function::DeviceClass::MassStorageController},
+    {0x02, pcie_function::DeviceClass::NetworkController},
+    {0x05, pcie_function::DeviceClass::MemoryController}};
+
 inline void getPCIeDeviceList(
     const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
     const nlohmann::json::json_pointer& jsonKeyName)
@@ -168,5 +175,16 @@ inline std::optional<pcie_device::DeviceType> redfishPcieDeviceTypeFromDbus(
     return it->second;
 }
 
+inline std::optional<pcie_function::DeviceClass> smbiosDevClassToRedfishDevClass(
+    uint8_t classCode)
+{
+    auto it = deviceClassCodeMap.find(classCode);
+    if (it == deviceClassCodeMap.end())
+    {
+        return pcie_function::DeviceClass::Other;
+    }
+    return it->second;
+}
+
 } // namespace pcie_util
 } // namespace redfish
