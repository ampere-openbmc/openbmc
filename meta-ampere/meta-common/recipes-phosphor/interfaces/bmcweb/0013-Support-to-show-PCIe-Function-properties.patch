     const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
     const nlohmann::json::json_pointer& jsonKeyName)
@@ -168,5 +175,16 @@ inline std::optional<pcie_device::DeviceType> redfishPcieDeviceTypeFromDbus(
     return it->second;
 }
 
+inline std::optional<pcie_function::DeviceClass> smbiosDevClassToRedfishDevClass(
+    uint8_t classCode)
+{
+    auto it = deviceClassCodeMap.find(classCode);
+    if (it == deviceClassCodeMap.end())
+    {
+        return pcie_function::DeviceClass::Other;
+    }
+    return it->second;
+}
+
