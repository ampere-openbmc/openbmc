+const std::map<uint8_t, pcie_function::DeviceClass> deviceClassCodeMap = {
+    {0x00, pcie_function::DeviceClass::Invalid},
+    {0x01, pcie_function::DeviceClass::MassStorageController},
+    {0x02, pcie_function::DeviceClass::NetworkController},
+    {0x05, pcie_function::DeviceClass::MemoryController}};
