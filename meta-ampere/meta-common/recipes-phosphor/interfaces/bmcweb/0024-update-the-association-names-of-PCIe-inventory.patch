From 51feaccbad1cdf712d352e9bc8d6cebd8b72c69c Mon Sep 17 00:00:00 2001
From: Thang Tran <thuutran@amperecomputing.com>
Date: Fri, 27 Jun 2025 07:13:13 +0700
Subject: [PATCH 3/3] update the association names of PCIe inventory

The list of association names of PCIe inventory is defined at [1],
bmcweb has to be updated to correct the name of associations.

[1] https://amperecomputing.atlassian.net/wiki/spaces/TST/pages/3441655907/System+Inventory+for+PCIe+devices+design#Association

Upstream-Status: Pending

Signed-off-by: Thang Tran <thuutran@amperecomputing.com>
---
 redfish-core/lib/network_adapter.hpp | 10 +++++-----
 redfish-core/lib/pcie.hpp            | 12 ++++++------
 redfish-core/lib/storage.hpp         |  6 +++---
 3 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/redfish-core/lib/network_adapter.hpp b/redfish-core/lib/network_adapter.hpp
index ac56fbc5..b5906616 100644
--- a/redfish-core/lib/network_adapter.hpp
+++ b/redfish-core/lib/network_adapter.hpp
@@ -85,7 +85,7 @@ inline void handleNetworkAdapterCollectionGet(
 
     // Get the list of PCIe device that includes "Item.Ethernet" interface
     dbus::utility::getAssociatedSubTreePathsById(
-        chassisId, reqpath, chassisInterfaces, "pcie_devices", ethernetItf,
+        chassisId, reqpath, chassisInterfaces, "containing", ethernetItf,
         [asyncResp, chassisId](
             const boost::system::error_code& ec,
             const dbus::utility::MapperGetSubTreePathsResponse& subtreePaths) {
@@ -251,7 +251,7 @@ inline void getNetworkDeviceFunctionsPaths(
         "xyz.openbmc_project.Inventory.Item.Ethernet"};
 
     dbus::utility::getAssociatedSubTreePathsById(
-        networkAdapterId, reqpath, ethernetItf, "provides_network", networkItf,
+        networkAdapterId, reqpath, ethernetItf, "containing", networkItf,
         [asyncResp, chassisId, networkAdapterId, callback{std::move(callback)}](
             const boost::system::error_code& ec,
             const dbus::utility::MapperGetSubTreePathsResponse& subtreePaths) {
@@ -318,7 +318,7 @@ inline void getValidNetworkAdapterPath(
         "xyz.openbmc_project.Inventory.Item.Ethernet"};
 
     dbus::utility::getAssociatedSubTreeById(
-        chassisId, reqpath, chassisInterfaces, "pcie_devices", ethernetItf,
+        chassisId, reqpath, chassisInterfaces, "containing", ethernetItf,
         [asyncResp, chassisId, networkAdapterId, callback{std::move(callback)}](
             const boost::system::error_code& ec,
             const dbus::utility::MapperGetSubTreeResponse&
@@ -533,7 +533,7 @@ inline void geFunctionPCIeFuncPaths(
         "xyz.openbmc_project.Inventory.Item.PCIeFunction"};
 
     dbus::utility::getAssociatedSubTreePathsById(
-        networkDeviceFuncId, reqpath, networkItf, "transmitted_by",
+        networkDeviceFuncId, reqpath, networkItf, "produced_by",
         pcieFunctionItf,
         [asyncResp, chassisId, networkAdapterId, networkDeviceFuncId,
          callback{std::move(callback)}](
@@ -604,7 +604,7 @@ inline void getValidNetworkDeviceFuncPath(
 
     // Get the list of PCIe device that includes "Item.Ethernet" interface
     dbus::utility::getAssociatedSubTreeById(
-        networkAdapterId, reqpath, ethernetItf, "provides_network",
+        networkAdapterId, reqpath, ethernetItf, "containing",
         networkDeviceFuncItf,
         [asyncResp, chassisId, networkAdapterId, networkDeviceFuncId,
          callback{std::move(callback)}](
diff --git a/redfish-core/lib/pcie.hpp b/redfish-core/lib/pcie.hpp
index d5240005..98a221a0 100644
--- a/redfish-core/lib/pcie.hpp
+++ b/redfish-core/lib/pcie.hpp
@@ -264,7 +264,7 @@ inline void getPCIeDeviceSlotPath(
     const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
     std::function<void(const std::string& pcieDeviceSlot)>&& callback)
 {
-    std::string associationPath = pcieDevicePath + "/contained_by";
+    std::string associationPath = pcieDevicePath + "/upstream_pcie_slot";
     dbus::utility::getAssociatedSubTreePaths(
         associationPath, sdbusplus::message::object_path(inventoryPath), 0,
         pcieSlotInterface,
@@ -766,7 +766,7 @@ inline void afterPCIeFunctionCollectionGet(
     const std::string& pcieDeviceId, const std::string& pcieDevicePath)
 {
     dbus::utility::getAssociationEndPoints(
-        pcieDevicePath + "/embedeing",
+        pcieDevicePath + "/exposing",
         [asyncResp, pcieDeviceId](const boost::system::error_code& ec,
                                   const dbus::utility::MapperEndPoints& resp) {
             if (ec)
@@ -929,7 +929,7 @@ inline void getDrivesLink(const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
 {
     const std::vector<std::string_view> driveInterface = {
         "xyz.openbmc_project.Inventory.Item.Drive"};
-    std::string endpointPath = pcieFuncPath + "/describeing";
+    std::string endpointPath = pcieFuncPath + "/producing";
 
     dbus::utility::getAssociatedSubTreePaths(
         endpointPath,
@@ -981,7 +981,7 @@ inline void getChassisId(
 
     // Get the first Chassis object path that contain this PCIe Device
     dbus::utility::getAssociatedSubTreePathsById(
-        pcieDeviceId, reqpath, pcieDevInterface, "chassis", chassisInterfaces,
+        pcieDeviceId, reqpath, pcieDevInterface, "contained_by", chassisInterfaces,
         [asyncResp, pcieDeviceId, callback{std::move(callback)}](
             const boost::system::error_code& ec,
             const dbus::utility::MapperGetSubTreePathsResponse& chassisPaths) {
@@ -1017,7 +1017,7 @@ inline void getNetworkLink(const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
         [asyncResp, pcieDeviceId, pcieFunctionId, pcieFuncPath](
             const std::string& chassisId) 
         {
-            std::string endpointPath = pcieFuncPath + "/received_by";
+            std::string endpointPath = pcieFuncPath + "/producing";
             const std::vector<std::string_view> networkInterface = {
                 "xyz.openbmc_project.Inventory.Item.NetworkInterface"};
 
@@ -1219,7 +1219,7 @@ inline void getValidPcieFunctionPath(
     static constexpr std::array<std::string_view, 1> functionInterface = {
         "xyz.openbmc_project.Inventory.Item.PCIeFunction"};
     dbus::utility::getAssociatedSubTree(
-        pcieDevicePath + "/embedeing",
+        pcieDevicePath + "/exposing",
         sdbusplus::message::object_path("/xyz/openbmc_project/inventory"), 0,
         functionInterface,
         [asyncResp, callback = std::move(callback), pcieFunctionIdStr](
diff --git a/redfish-core/lib/storage.hpp b/redfish-core/lib/storage.hpp
index e635a8cf..7906532c 100644
--- a/redfish-core/lib/storage.hpp
+++ b/redfish-core/lib/storage.hpp
@@ -256,7 +256,7 @@ inline void afterSystemsStorageGetSubtree(
         [asyncResp, storageId, driveInterface](const std::string& storagePath,
         [[maybe_unused]] const std::string&) {
             dbus::utility::getAssociatedSubTreePaths(
-                storagePath + "/provides_storage",
+                storagePath + "/containing",
                 sdbusplus::message::object_path(
                     "/xyz/openbmc_project/inventory"), 0, driveInterface,
                 [asyncResp, storageId](const boost::system::error_code& ec2,
@@ -838,7 +838,7 @@ inline void getValidDrivePath(
     static constexpr std::array<std::string_view, 1> driveInterface = {
         "xyz.openbmc_project.Inventory.Item.Drive"};
     dbus::utility::getAssociatedSubTree(
-        storagePath + "/provides_storage",
+        storagePath + "/containing",
         sdbusplus::message::object_path("/xyz/openbmc_project/inventory"), 0,
         driveInterface,
         [asyncResp, callback = std::move(callback),
@@ -892,7 +892,7 @@ inline void getDriveFunction(
     const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
     const std::string& storageId, const std::string& drivePath)
 {
-    std::string endpointPath = drivePath + "/described_by";
+    std::string endpointPath = drivePath + "/produced_by";
     const std::vector<std::string_view> pcieFuncInterface =
         {"xyz.openbmc_project.Inventory.Item.PCIeFunction"};
 
