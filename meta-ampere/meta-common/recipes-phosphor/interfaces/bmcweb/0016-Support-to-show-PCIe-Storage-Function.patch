-    getDrives(asyncResp);
-    asyncResp->res.jsonValue["Controllers"]["@odata.id"] =
-        boost::urls::format("/redfish/v1/Systems/{}/Storage/{}/Controllers",
-                            BMCWEB_REDFISH_SYSTEM_URI_NAME, storageId);
+    getValidStoragePath(
+        storageId, asyncResp,
+        [asyncResp, storageId](const std::string& storagePath,
+                               [[maybe_unused]] const std::string&) {
+            dbus::utility::getProperty<std::vector<std::string>>(
+                "xyz.openbmc_project.ObjectMapper",
+                storagePath + "/provides_storage",
+                "xyz.openbmc_project.Association", "endpoints",
+                [asyncResp,
+                 storageId](const boost::system::error_code& ec2,
+                            const std::vector<std::string>& driveList) {
+                    if (ec2)
+                    {
+                        if (ec2.value() != EBADR)
+                        {
+                            BMCWEB_LOG_ERROR("DBUS response error {}",
+                                             ec2.value());
+                            messages::internalError(asyncResp->res);
+                        }
+                        return;
+                    }
+
+                    nlohmann::json::array_t drives;
+                    for (const std::string& drivePath : driveList)
+                    {
+                        std::string id =
+                            sdbusplus::message::object_path(drivePath)
+                                .filename();
+                        if (id.empty())
+                        {
+                            continue;
+                        }
+
+                        nlohmann::json::object_t drive;
+                        drive["@odata.id"] = boost::urls::format(
+                            "/redfish/v1/Systems/{}/Storage/{}/Drives/{}",
+                            BMCWEB_REDFISH_SYSTEM_URI_NAME, storageId, id);
+                        drives.emplace_back(std::move(drive));
+                    }
+                    asyncResp->res.jsonValue["Drives@odata.count"] =
+                        drives.size();
+                    asyncResp->res.jsonValue["Drives"] = std::move(drives);
+                });
+        });
 }
 
