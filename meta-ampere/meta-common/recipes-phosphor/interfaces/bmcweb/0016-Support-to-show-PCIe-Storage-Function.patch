+inline void getValidDrivePath(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& storagePath, const std::string& driveId,
+    const std::function<void(const std::string& drivePath)>& callback)
+{
+    static constexpr std::array<std::string_view, 1> driveInterface = {
+        "xyz.openbmc_project.Inventory.Item.Drive"};
+    dbus::utility::getAssociatedSubTree(
+        storagePath + "/provides_storage",
+        sdbusplus::message::object_path("/xyz/openbmc_project/inventory"), 0,
+        driveInterface,
+        [asyncResp, callback = std::move(callback),
+         driveId](const boost::system::error_code& ec,
+                  const dbus::utility::MapperGetSubTreeResponse& subtree) {
+            if (ec)
+            {
+                BMCWEB_LOG_ERROR("DBUS response error for Subtree {}",
+                                 ec.value());
+                messages::internalError(asyncResp->res);
+            }
+
+            if (subtree.empty())
+            {
+                BMCWEB_LOG_DEBUG("DBUS response error");
+                return;
+            }
+
+            for (const auto& [drivePath, serviceMaps] : subtree)
+            {
+                std::string driveName =
+                    sdbusplus::message::object_path(drivePath).filename();
+
+                if (driveId == driveName)
+                {
+                    callback(drivePath);
+                    return;
+                }
+            }
+
+            BMCWEB_LOG_ERROR("Invalid Drive path {}", driveId);
+            messages::resourceNotFound(asyncResp->res, "Drive", driveId);
+        });
+}
+
+inline void addDriveCommonProperties(crow::Response& resp,
+                                     const std::string& storageId,
+                                     const std::string& driveId)
+{
+    resp.jsonValue["@odata.type"] = "#Drive.v1_7_0.Drive";
+    resp.jsonValue["@odata.id"] =
+        boost::urls::format("/redfish/v1/Systems/{}/Storage/{}/Drives/{}",
+                            BMCWEB_REDFISH_SYSTEM_URI_NAME, storageId, driveId);
+    resp.jsonValue["Name"] = "Drive";
+    resp.jsonValue["Id"] = driveId;
+    // Default it to Enabled
+    resp.jsonValue["Status"]["State"] = resource::State::Enabled;
+}
+
+inline void getDriveFunction(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& storageId, const std::string& drivePath)
+{
+    auto found = drivePath.find_last_of("/");
+    std::string functionPath = drivePath.substr(0, found);
+
+    std::string functionName =
+        sdbusplus::message::object_path(functionPath).filename();
+
+    // Check if the parent of driveId is /{path}/Function#
+    size_t pos = functionName.find("Function");
+    if (pos == std::string::npos)
+    {
+        // Not found
+        messages::resourceNotFound(asyncResp->res, "Function", drivePath);
+        return;
+    }
+
+    // Limitation: assume that Storage ID and PCIe Device ID is the same
+    nlohmann::json::array_t functions;
+    nlohmann::json::object_t function;
+    function["@odata.id"] = boost::urls::format(
+        "/redfish/v1/Systems/{}/PCIeDevices/{}/PCIeFunctions/{}",
+        BMCWEB_REDFISH_SYSTEM_URI_NAME, storageId, functionName);
+    functions.emplace_back(std::move(function));
+    // Link to PCIe Function
+    asyncResp->res.jsonValue["Links"]["PCIeFunctions@odata.count"] =
+        functions.size();
+    asyncResp->res.jsonValue["Links"]["PCIeFunctions"] = std::move(functions);
+}
+
+inline void handleSystemsStorageDriveGetById(
+    App& app, const crow::Request& req,
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    const std::string& systemName, const std::string& storageId,
+    const std::string& driveId)
+{
+    if (!redfish::setUpRedfishRoute(app, req, asyncResp))
+    {
+        return;
+    }
+    if constexpr (BMCWEB_EXPERIMENTAL_REDFISH_MULTI_COMPUTER_SYSTEM)
+    {
+        // Option currently returns no systems.  TBD
+        messages::resourceNotFound(asyncResp->res, "ComputerSystem",
+                                   systemName);
+        return;
+    }
+
+    if (systemName != BMCWEB_REDFISH_SYSTEM_URI_NAME)
+    {
+        messages::resourceNotFound(asyncResp->res, "ComputerSystem",
+                                   systemName);
+        return;
+    }
+
+    getValidStoragePath(
+        storageId, asyncResp,
+        [asyncResp, storageId,
+         driveId](const std::string& storagePath, const std::string& service) {
+            getValidDrivePath(
+                asyncResp, storagePath, driveId,
+                [asyncResp, storageId, driveId, storagePath,
+                 service](const std::string& drivePath) {
+                    addDriveCommonProperties(asyncResp->res, storageId,
+                                             driveId);
+                    // SMBIOS Type 128: Model, PartNumber, SerialNumber
+                    getDriveAsset(asyncResp, service, storagePath);
+                    // Drive: CapacityBytes, MediaType
+                    getDriveItemProperties(asyncResp, service, drivePath);
+                    // Link to PCIe Function
+                    getDriveFunction(asyncResp, storageId, drivePath);
+                });
+        });
+}
+
 inline void requestRoutesDrive(App& app)
 {
     BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Storage/1/Drives/<str>/")
@@ -729,6 +967,14 @@ inline void requestRoutesDrive(App& app)
             std::bind_front(handleSystemsStorageDriveGet, std::ref(app)));
 }
 
+inline void requestRoutesDriveById(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Storage/<str>/Drives/<str>/")
+        .privileges(redfish::privileges::getDrive)
+        .methods(boost::beast::http::verb::get)(
+            std::bind_front(handleSystemsStorageDriveGetById, std::ref(app)));
+}
