+void ChassisIntrusionGpioSensor::start()
+{
+    pollSensorStatus();
+
+    // Initial sensor value update for GPIO class which uses interrupts.
+    // This is placed after the polling to Fd to avoid missing of events.
+    auto value = mGpioLine.get_value();
+    if (value >= 0)
+    {
+        updateValue(value);
+    }
+}
