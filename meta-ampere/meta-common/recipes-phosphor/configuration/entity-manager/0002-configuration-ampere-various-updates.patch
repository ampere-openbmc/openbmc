 3 files changed, 23 insertions(+)

diff --git a/configurations/mtjade.json b/configurations/mtjade.json
index ef1bcc7..8a50c63 100644
--- a/configurations/mtjade.json
+++ b/configurations/mtjade.json
@@ -1931,6 +1931,10 @@
