[Unit]
Description=Ampere BERT handler for power action of the host
After=obmc-host-stop@0.target
Before=obmc-host-startmin@0.target
Before=obmc-host-start@0.target
Before=obmc-host-warm-reboot@0.target
Before=obmc-host-force-warm-reboot@0.target
Before=obmc-host-reboot@0.target
Before=obmc-power-start-pre@0.target

[Service]
Restart=no
ExecStart=/usr/sbin/ampere-bert-power-handle.sh
SyslogIdentifier=ampere-bert-power-handle
Type=oneshot
